# Vercel Blob Storage (Private Store)
# Optional in local dev: defaults to local file system in .snapcollect-data/
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Automated Reminders Cron Secret
# Used to authenticate POST /api/reminders/cron from Vercel cron
CRON_SECRET="your-cron-secret-key"

# Twilio SMS / WhatsApp Intake (Optional)
# In local dev and demo mode, the in-app WhatsApp simulator handles all testing
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+15553910042"

# Resend Email Delivery (Optional)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="intake@yourfirm.com"

# Vercel AI Gateway (Optional)
AI_GATEWAY_API_KEY=""
